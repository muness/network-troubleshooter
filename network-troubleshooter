from urllib.parse import quote, urlsplit

TITLE = 'Network Troubleshooter'
NM = 'org.freedesktop.NetworkManager'
TEST_HOST = 'archlinux.org'
DEFAULT_TARGETS = {4: '1.1.1.1', 6: '2606:4700:4700::1111'}
FIELDS = ('GENERAL.STATE,GENERAL.REASON,GENERAL.CONNECTION,GENERAL.CON-UUID,'
          'WIRED-PROPERTIES.CARRIER,IP4.ADDRESS,IP6.ADDRESS,IP4.GATEWAY,IP6.GATEWAY,'
          'GENERAL.IP4-CONNECTIVITY,GENERAL.IP6-CONNECTIVITY,CONNECTIONS.AVAILABLE-CONNECTIONS')
ENV = {**os.environ, 'LC_ALL': 'C'}
CONFIG_DIR = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'network-troubleshooter'
STATE_DIR = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'network-troubleshooter'
RECOVERY_UNIT = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.@-]*\.service')
USB_WAKE_HELPER = '/usr/local/libexec/network-troubleshooter-wake-usb-ethernet'
SYS_NET = Path('/sys/class/net')
USB_BUS = Path('/sys/bus/usb')
GENERIC_USB_ETHERNET_DRIVERS = {'cdc_ether', 'cdc_ncm', 'rndis_host'}


def run(*args, timeout=5):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=ENV)
        return result.returncode, (result.stdout or result.stderr).strip()
    except subprocess.TimeoutExpired as error:
        return 124, str(error)
    except OSError as error:
        return 2, str(error)


def adapters():
    code, text = run('nmcli', '-t', '-e', 'no', '-f', 'DEVICE,TYPE,STATE', 'device', 'status')
    if code:
        return [], text
    devices = []
    for line in text.splitlines():
        device, kind, state = line.split(':', 2)
        if kind in ('ethernet', 'wifi') and state != 'unmanaged':
            devices.append((device, 'Ethernet' if kind == 'ethernet' else 'Wi-Fi', state))
    return devices, ''


def desktop(*args):
    return subprocess.run(['yad', '--center', '--fixed', '--borders=14',
                           f'--title={TITLE}', *args], capture_output=True, text=True)


def choose(devices):
    if len(devices) == 1:
        return devices[0][0]
    result = desktop('--list', '--width=560', '--height=260', '--text=Which adapter should we check?',
                     '--column=Adapter', '--column=Type', '--column=State',
                     '--print-column=1', '--separator=|', '--button=Close:1',
                     '--button=Check adapter:0', '--', *(escape(field) for row in devices for field in row))
    return unescape(result.stdout.strip().removesuffix('|')) if result.returncode == 0 else ''


def addresses(fields):
    families = set()
    for key, value in fields:
        if key.startswith(('IP4.ADDRESS[', 'IP6.ADDRESS[')):
            try:
                address = ipaddress.ip_interface(value).ip
                if not (address.is_link_local or address.is_unspecified):
                    families.add(address.version)
            except ValueError:
                continue
    return families


def ping_status(device, target):
    family = ipaddress.ip_address(target).version
    code, _ = run('ping', f'-{family}', '-n', '-I', device, '-c', '1', '-w', '2',
                  target, timeout=3)
    return {0: 'Replied', 1: 'No reply'}.get(code, 'Unavailable')


def ping_summary(results, notes):
    return (results[0] if len(set(results)) == 1 else 'Mixed'), ' · '.join(notes)


def ping_check(device, targets):
    if not targets:
        return 'Skipped', 'No route to the default ping targets on this adapter.'
    results = [ping_status(device, target) for target in targets]
    return ping_summary(results, [f'{target} ({result.lower()})' for target, result in zip(targets, results)])


def parse_ping_target(value):
    if '%' in value:
        raise ValueError('Use an unscoped IP address. The selected adapter sets the scope.')
    return str(ipaddress.ip_address(value))


def parse_dns_target(value):
    try:
        host = value.encode('idna').decode('ascii')
    except UnicodeError:
        raise ValueError('Enter a hostname such as example.org.') from None
    labels = host.removesuffix('.').split('.')
    if len(host.removesuffix('.')) > 253 or any(
            not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', label) for label in labels):
        raise ValueError('Enter a hostname such as example.org.')
    try:
        ipaddress.ip_address(host.removesuffix('.'))
    except ValueError:
        return host
    raise ValueError('Enter a hostname such as example.org.')


def edit_target(current, label, prompt, parse, error):
    result = desktop('--entry', '--no-markup', '--width=450',
                     f'--text={prompt}', f'--entry-label={label}', f'--entry-text={current or ""}',
                     '--button=Cancel:1', '--button=Clear:2', '--button=Apply:0')
    if result.returncode == 2:
        return None
    if result.returncode != 0:
        return current
    value = result.stdout.strip()
    if not value:
        return None
    try:
        return parse(value)
    except ValueError:
        desktop('--image=dialog-error', '--no-markup',
                f'--text={error}', '--button=Close:0')
        return current


def wifi_details(device, profile, details):
    _, radio = run('nmcli', '-g', 'WIFI', 'radio')
    link_code, link = run('iw', 'dev', device, 'link')
    details.extend([f'Wi-Fi radio: {radio}', f'Wi-Fi link:\n{link}'])
    if profile:
        code, ssid = run('nmcli', '-e', 'no', '-g', '802-11-wireless.ssid',
                         'connection', 'show', 'uuid', profile)
        if code == 0 and ssid and ssid != '--':
            code, scan = run('nmcli', '-t', '-e', 'no', '-f', 'SSID,CHAN,SIGNAL',
                             'device', 'wifi', 'list', 'ifname', device, '--rescan', 'no')
            matches = [line for line in scan.splitlines() if line.rsplit(':', 2)[0] == ssid]
            visibility = ', '.join(matches) if matches else 'no match in cache'
            details.extend([f'Saved SSID: {ssid}',
                            f'Saved network (SSID:channel:signal): {visibility if code == 0 else scan}'])
    return radio, link if link_code == 0 else ''


def ip_json(*args):
    code, output = run('ip', '-j', *args)
    if code == 0:
        try:
            records = json.loads(output)
            if isinstance(records, list):
                return [record for record in records if isinstance(record, dict)]
        except ValueError:
            pass
    return []


def gateway_neighbor(device, gateway, family):
    records = ip_json(f'-{family}', 'neigh', 'show', 'to', gateway, 'dev', device)
    for entry in records:
        states = entry.get('state') or []
        if 'FAILED' in states:
            return 'neighbor resolution failed'
        if 'INCOMPLETE' in states:
            return 'neighbor resolution pending'
        if entry.get('lladdr'):
            return 'link-layer address known'
    return 'neighbor state unknown'


def gateway_check(device, data):
    results, notes = [], []
    for family in (4, 6):
        try:
            gateway = parse_ping_target(data.get(f'IP{family}.GATEWAY', '').removesuffix(f'%{device}'))
            if ipaddress.ip_address(gateway).version != family:
                continue
        except ValueError:
            continue
        result = ping_status(device, gateway)
        observation = result.lower()
        if result == 'No reply':
            observation += f', {gateway_neighbor(device, gateway, family)}'
        results.append(result)
        notes.append(f'{gateway} ({observation})')
    if not results:
        return 'Skipped', 'No gateway address was reported for this adapter.'
    return ping_summary(results, notes)


def system_route_check(device):
    choices, notes = set(), []
    for family, target in DEFAULT_TARGETS.items():
        route = ip_json(f'-{family}', 'route', 'get', target)
        chosen = route[0].get('dev') if route else None
        if chosen:
            choices.add('Selected adapter' if chosen == device else 'Other adapter')
        notes.append(f'IPv{family} to {target} via {chosen}' if chosen else
                     f'IPv{family} to {target}: no route confirmed')
    status = 'Mixed' if len(choices) > 1 else next(iter(choices), 'Unverified')
    return status, ' · '.join(notes)


def usb_configuration_classes(descriptors):
    """Read interface classes at alternate setting zero in each USB configuration."""
    configurations = {}
    classes = None
    offset = 0
    while offset + 2 <= len(descriptors):
        length, kind = descriptors[offset:offset + 2]
        if length < 2 or offset + length > len(descriptors):
            return {}
        descriptor = descriptors[offset:offset + length]
        if kind == 2 and length >= 9:  # Configuration descriptor
            classes = configurations.setdefault(descriptor[5], set())
        elif kind == 4 and length >= 9 and classes is not None and descriptor[3] == 0:
            classes.add(descriptor[5])  # bInterfaceClass
        offset += length
    return configurations if offset == len(descriptors) else {}


def usb_ethernet_link_hint(device, details):
    """Collect evidence for a USB Ethernet adapter that reports no carrier."""
    try:
        interface = (SYS_NET / device / 'device').resolve(strict=True)
        if (interface / 'subsystem').resolve() != USB_BUS:
            return ''
        usb = interface.parent
        driver = (interface / 'driver').readlink().name
        usb_id = ':'.join((usb / attr).read_text().strip() for attr in ('idVendor', 'idProduct'))
        active = (usb / 'bConfigurationValue').read_text().strip()
    except OSError:
        return ''

    details.append(f'USB Ethernet: {usb_id} at {usb.name}, driver {driver}, configuration {active}')
    try:
        power = (usb / 'power/runtime_status').read_text().strip()
        details.append(f'USB runtime power state: {power}')
    except OSError:
        pass
    try:
        configs = usb_configuration_classes((usb / 'descriptors').read_bytes())
    except OSError:
        configs = {}
    vendor_modes = [str(number) for number, classes in sorted(configs.items())
                    if str(number) != active and classes == {0xff}]
    if configs:
        modes = ', '.join(vendor_modes) or 'none found'
        details.append(f'Alternate vendor-specific USB configurations: {modes}')

    port = re.escape(usb.name)
    code, logs = run('journalctl', '-b', '-k', '--since=-15min', '-n', '35', '--no-pager',
                     '-o', 'cat', '--grep', rf'(^|\s){port}([:\s]|$)')
    details.append(f'Recent USB adapter kernel messages (last 15 minutes):\n'
                   f'{logs or "No matching messages available."}')
    resets = sum(line.startswith(f'usb {usb.name}: reset ') for line in logs.splitlines()) if code == 0 else 0
    hints = []
    if resets >= 2:
        hints.append('The kernel logged repeated resets of this USB adapter.')
    if driver in GENERIC_USB_ETHERNET_DRIVERS and vendor_modes:
        hints.append(f'The adapter uses the generic {driver} driver and offers a vendor-specific USB mode. '
                     f'If the cable and switch port work, check native driver support for {usb_id}.')
    return ' '.join(hints)


ETHERNET_COUNTERS = {'carrier_down_count': 'carrier losses',
                     'statistics/rx_crc_errors': 'receive CRC errors'}


def ethernet_value(device, attribute):
    try:
        return (SYS_NET / device / attribute).read_text().strip()
    except OSError:
        return ''


def ethernet_counters(device):
    index = ethernet_value(device, 'ifindex')
    counts = {}
    for attribute, label in ETHERNET_COUNTERS.items():
        value = ethernet_value(device, attribute)
        if value.isdecimal():
            counts[label] = int(value)
    return index, counts


def ethernet_link_details(device, baseline, details, history):
    speed = ethernet_value(device, 'speed')
    duplex = ethernet_value(device, 'duplex')
    link = f'Negotiated link: {int(speed):,} Mbps' if speed.isdecimal() and int(speed) > 0 else ''
    if duplex in ('half', 'full'):
        link = f'{link}, {duplex} duplex' if link else f'{duplex.capitalize()} duplex'
    index, counts = ethernet_counters(device)
    window = 'During this check'
    if history is not None:
        previous = history.get(device)
        history[device] = index, counts
        if previous and index and index == previous[0]:
            baseline = previous
            window = 'Since the last check'
    before_index, before = baseline
    deltas = []
    if index and index == before_index:
        deltas = [f'{label} +{count - before[label]}' for label, count in counts.items()
                  if label in before and count > before[label]]
    if link or counts:
        details.append(f'Ethernet link sample ({window.lower()}): {link or "Speed unavailable"}\n'
                       f'Counters before: {before}\nCounters after: {counts}')
    observations = [f'{link}.' if link else '']
    if deltas:
        observations.append(f'{window}: {", ".join(deltas)}.')
    return ' '.join(filter(None, observations))


def dns_answers(output):
    for line in output.splitlines():
        value, _, link = line.partition('-- link:')
        try:
            yield ipaddress.ip_address(value.split()[-1]), link.strip()
        except (ValueError, IndexError):
            continue


def dns_target_check(device, hostname, details):
    code, domains = run('resolvectl', 'domain', device)
    details.append(f'DNS domains for selected adapter (exit {code}):\n{domains}')
    # The CLI prefixes the list with Link N (interface):.
    domains = domains.partition(':')[2].strip() if code == 0 else ''
    outcomes = []
    scoped = False
    for label, options in (('Selected adapter', ('-i', device)), ('System resolver', ())):
        code, output = run('resolvectl', *options, '--cache=no', 'query', hostname)
        details.append(f'{label} DNS lookup for {hostname} (exit {code}):\n{output}')
        answers = list(dns_answers(output)) if code == 0 else []
        links = sorted({link for _, link in answers if link})
        if options:
            scoped = device in links
        outcome = f'answer via {", ".join(links)}' if links else (
            'answer with no reported link' if answers else 'no answer confirmed')
        outcomes.append(f'{label}: {outcome}.')
    if domains:
        outcomes.append(f'Selected adapter DNS domains: {domains}.')
    return ('Resolved on adapter' if scoped else 'Unverified'), f'{hostname}. {" ".join(outcomes)}'


def diagnose(device, kind, ping_target=None, details=None, profile_hint=None, *,
             dns_target=None, ethernet_history=None):
    details = details if details is not None else []
    baseline = ethernet_counters(device) if kind == 'Ethernet' else None
    result = diagnose_adapter(device, kind, ping_target, details, profile_hint)
    rows = result[1]
    rows['System route'] = system_route_check(device)
    if baseline is not None and rows['Link'][0] == 'Up':
        link = ethernet_link_details(device, baseline, details, ethernet_history)
        if link:
            rows['Link'] = ('Up', link)
    if dns_target:
        rows['DNS target'] = dns_target_check(device, dns_target, details)
    return result


def diagnose_adapter(device, kind, ping_target, details, profile_hint):
    rows = {step: ('Skipped', 'Requires an active link with an IP address.')
            for step in ('Link', 'IP address', 'Route', 'System route', 'Gateway', 'Ping', 'DNS', 'Sign-in', 'Internet')}
    reconnect = portal = ''
    code, output = run('nmcli', '-t', '-e', 'no', '-f', FIELDS, 'device', 'show', device)
    details.append(f'NetworkManager device snapshot:\n{output}')
    if code:
        rows['Link'] = ('Unavailable', output)
        return 'Couldn’t read adapter state', rows, reconnect, portal

    fields = [line.split(':', 1) for line in output.splitlines() if ':' in line]
    data = dict(fields)
    state = data.get('GENERAL.STATE', '').partition(' ')[0]
    reason = re.fullmatch(r'[1-9][0-9]* \((.+)\)', data.get('GENERAL.REASON', ''))
    reason_note = f' NetworkManager reports: {reason[1]}.' if reason else ''
    profile = data.get('GENERAL.CON-UUID', '')
    if profile and profile != '--':
        reconnect = profile
    elif kind == 'Wi-Fi' or data.get('WIRED-PROPERTIES.CARRIER') == 'on':
        saved = [value.split(' | ', 1)[0] for key, value in fields
                 if key.startswith('CONNECTIONS.AVAILABLE-CONNECTIONS[')]
        if len(saved) == 1:
            reconnect = saved[0]

    if kind == 'Ethernet':
        carrier = data.get('WIRED-PROPERTIES.CARRIER')
        if carrier == 'off':
            usb_hint = usb_ethernet_link_hint(device, details)
            hint = ('Use Repair connection to wake the suspended USB Ethernet adapter.'
                    if usb_wake_available(device) else 'Check the Ethernet cable, dock, or switch.')
            if usb_hint:
                hint = f'{hint} {usb_hint}'
            rows['Link'] = ('No cable link', hint + reason_note)
            return 'Ethernet link is down', rows, '', portal
        if carrier != 'on':
            rows['Link'] = ('Unverified', 'NetworkManager did not report the cable link state.' + reason_note)
            return 'Ethernet link unverified', rows, reconnect, portal
        rows['Link'] = ('Up', 'The adapter detects an Ethernet link.')
    else:
        radio, link = wifi_details(device, reconnect or profile_hint, details)
        if radio == 'disabled':
            rows['Link'] = ('Off', 'Turn Wi-Fi on from the network menu.')
            return 'Wi-Fi is off', rows, '', portal
        if link == 'Not connected.' or not link and state not in ('70', '80', '90', '100'):
            hint = 'Choose a network in the Wi-Fi menu.'
            if reconnect:
                hint += ' You can also reconnect the saved profile.'
            rows['Link'] = ('Disconnected', hint + reason_note)
            return 'Wi-Fi is disconnected', rows, reconnect, portal
        rows['Link'] = ('Joined', data.get('GENERAL.CONNECTION') or 'Joined a Wi-Fi network.')

    rows['Gateway'] = gateway_check(device, data)
    families = addresses(fields)
    if not families:
        if ping_target:
            rows['Ping'] = ping_check(device, [ping_target])
        if state == '70':
            rows['IP address'] = ('Pending', 'NetworkManager is still configuring an IP address.' + reason_note)
            return 'IP configuration is in progress', rows, reconnect, portal
        hint = 'No address beyond link-local.'
        hint += reason_note or ' Check DHCP or the saved IP settings.'
        rows['IP address'] = ('Missing', hint)
        return 'The adapter has no usable IP address', rows, reconnect, portal
    rows['IP address'] = ('Assigned', ', '.join(f'IPv{family}' for family in sorted(families)))

    routed = [family for family in sorted(families)
              if run('ip', f'-{family}', 'route', 'get', DEFAULT_TARGETS[family], 'oif', device)[0] == 0]
    rows['Route'] = (('Found', ', '.join(f'IPv{family}' for family in routed)) if routed
                     else ('Missing', 'No route to the test destinations on this adapter.'))
    ping_targets = [ping_target] if ping_target else [DEFAULT_TARGETS[family] for family in routed]
    rows['Ping'] = ping_check(device, ping_targets)
    run('nmcli', '-w', '4', 'networking', 'connectivity', 'check')
    code, connectivity = run('nmcli', '-g', 'GENERAL.IP4-CONNECTIVITY,GENERAL.IP6-CONNECTIVITY',
                             'device', 'show', device)
    states = {line.partition(' ')[0] for line in connectivity.splitlines()} if code == 0 else set()
    details.append(f'NetworkManager adapter connectivity:\n{connectivity}')
    if '2' in states:
        rows['Sign-in'] = ('Required', 'NetworkManager detected a captive portal on this adapter.')
        portal = portal_url()
    else:
        rows['Sign-in'] = (('Not detected', 'NetworkManager did not report a sign-in page.')
                           if '4' in states else ('Unverified', 'No confirmed portal or full connectivity.'))
    if not routed:
        for step in ('DNS', 'Internet'):
            rows[step] = ('Skipped', 'Requires a route on this adapter.')
        if state == '100' and '4' not in states and not portal:
            portal = portal_url()
        headline = 'Sign in to use this network' if '2' in states else 'The adapter has no route to the internet'
        return headline, rows, reconnect, portal

    resolved = []
    for family in routed:
        record_type = 'A' if family == 4 else 'AAAA'
        code, output = run('resolvectl', '-i', device, '--cache=no',
                           f'--type={record_type}', 'query', TEST_HOST)
        details.append(f'Per-adapter DNS ({record_type}, exit {code}):\n{output}')
        for address, link in dns_answers(output) if code == 0 else ():
            if link == device and address.version == family:
                resolved.append(address)
                break
    rows['DNS'] = (('Resolved', 'The test site resolved on this adapter.') if resolved else
                   ('Unverified', 'No per-adapter DNS answer. This check needs systemd-resolved.'))

    # Supply the address returned by this adapter's resolver. With no such
    # answer, curl may use system DNS, but the HTTPS socket stays bound.
    curl = ['curl', '-q', '--noproxy', '*', '--interface', f'if!{device}', '--max-time', '5',
            '-sS', '-o', '/dev/null', '-w', '%{http_code}']
    if resolved:
        host_addresses = ','.join(str(a) if a.version == 4 else f'[{a}]' for a in resolved)
        curl += ['--resolve', f'{TEST_HOST}:443:{host_addresses}']
    code, status = run(*curl, f'https://{TEST_HOST}/', timeout=6)
    details.append(f'Adapter-bound HTTPS (exit {code}):\n{status}')
    online = code == 0 and status == '200'
    rows['Internet'] = (('Reached', f'HTTPS worked through {device}.') if online else
                        ('Unverified', f'{TEST_HOST} did not return the expected HTTPS response.'))
    headline = ('Sign in to use this network' if '2' in states else
                'Internet access verified' if online else 'Internet access unverified')
    if not online and '4' not in states and not portal and state == '100':
        portal = portal_url()
        rows['Sign-in'] = ('Unverified', 'Try sign-in if this network uses a login page.')
    return headline, rows, reconnect, portal


def portal_url():
    code, output = run('busctl', '--system', '--json=short', 'get-property', NM,
                       '/org/freedesktop/NetworkManager', NM, 'ConnectivityCheckUri')
    if code == 0:
        try:
            url = json.loads(output)['data']
            parsed = urlsplit(url)
            if parsed.scheme == 'http' and parsed.hostname:
                return url
        except (ValueError, TypeError, KeyError, AttributeError):
            pass
    return 'http://nmcheck.gnome.org/check_network_status.txt'


def launch_portal(device, kind, url):
    path = CONFIG_DIR / 'portal.json'
    if path.exists():
        try:
            config = json.loads(path.read_text(encoding='utf-8'))
            command = config.get('wifi' if kind == 'Wi-Fi' else 'ethernet')
        except (OSError, ValueError, AttributeError) as error:
            return 2, f'Could not read portal helper settings: {error}'
        if command is not None:
            if (not isinstance(command, list) or not command
                    or not all(isinstance(arg, str) and arg for arg in command)
                    or not Path(command[0]).is_absolute()):
                return 2, 'Portal helper must be an argument list starting with an absolute executable path.'
            return run(*command, device, url, timeout=15)

    helper = shutil.which('omarchy-network-captive-portal')
    try:
        subprocess.Popen([helper or 'xdg-open', url], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        return 2, str(error)
    return 0, 'Opened the system sign-in helper.'


def recovery_settings():
    try:
        config = json.loads((CONFIG_DIR / 'recovery.json').read_text(encoding='utf-8'))
        device, profile, driver, unit = (config[key] for key in ('adapter', 'profile', 'driver', 'unit'))
        if (re.fullmatch(r'[a-fA-F0-9-]{36}', profile)
                and re.fullmatch(r'[A-Za-z0-9_-]+', driver)
                and RECOVERY_UNIT.fullmatch(unit)):
            return device, profile, driver, unit
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def adapter_driver(device):
    link = Path('/sys/class/net') / device / 'device/driver'
    return link.resolve().name if link.is_symlink() else ''


def driver_recovery_blocker(device, kind, driver):
    if adapter_driver(device) != driver:
        return 'The adapter no longer uses the configured driver.'
    if run('nmcli', '-g', 'GENERAL.AUTOCONNECT', 'device', 'show', device) != (0, 'yes'):
        return 'NetworkManager does not currently allow this adapter to autoconnect.'
    if kind == 'Ethernet':
        code, output = run('nmcli', '-g', 'GENERAL.STATE,WIRED-PROPERTIES.CARRIER',
                           'device', 'show', device)
        state, _, carrier = output.partition('\n')
        if code or not state.startswith('30 ') or carrier != 'on':
            return 'Ethernet driver recovery requires a disconnected adapter with carrier.'
        return ''
    if run('nmcli', '-g', 'WIFI', 'radio') != (0, 'enabled'):
        return 'The Wi-Fi radio is off or its state could not be read.'
    code, output = run('nmcli', '-t', '-f', 'DEVICE,TYPE', 'device', 'status')
    if code or [line for line in output.splitlines() if line.endswith(':wifi')] != [f'{device}:wifi']:
        return 'Wi-Fi driver recovery requires exactly one Wi-Fi adapter.'
    if run('iw', 'dev', device, 'link') != (0, 'Not connected.'):
        return 'The adapter has joined Wi-Fi or its link state could not be read.'
    return ''


def profile_matches_kind(profile, kind):
    connection_type = '802-11-wireless' if kind == 'Wi-Fi' else '802-3-ethernet'
    return run('nmcli', '-g', 'connection.type', 'connection', 'show', 'uuid', profile) == (0, connection_type)


def recovery_unit_loaded(unit):
    return run('/usr/bin/systemctl', 'show', '-p', 'LoadState', '--value', unit) == (0, 'loaded')


def configure_recovery(device, profile, unit):
    if os.geteuid() == 0:
        raise ValueError('Run recovery setup as your desktop user.')
    if not RECOVERY_UNIT.fullmatch(unit):
        raise ValueError('Enter a systemd .service unit name.')
    devices, error = adapters()
    kind = next((kind for name, kind, _ in devices if name == device), None)
    if not kind:
        raise ValueError(error or f'{device} is not a managed Wi-Fi or Ethernet adapter.')
    driver = adapter_driver(device)
    if not re.fullmatch(r'[A-Za-z0-9_-]+', driver):
        raise ValueError(f'Could not identify the driver for {device}.')
    if not re.fullmatch(r'[a-fA-F0-9-]{36}', profile) or not profile_matches_kind(profile, kind):
        raise ValueError(f'Enter the UUID of a saved {kind} profile.')
    if not recovery_unit_loaded(unit):
        raise ValueError(f'Install {unit} as a system service first.')

    config = dict(adapter=device, profile=profile, driver=driver, unit=unit)
    CONFIG_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = CONFIG_DIR / 'recovery.json'
    with tempfile.TemporaryDirectory(dir=CONFIG_DIR) as directory:
        staged = Path(directory) / path.name
        staged.write_text(json.dumps(config, indent=2) + '\n', encoding='utf-8')
        staged.replace(path)
    return path


def configured_recovery(device, kind, config, reconnect):
    if not config or config[0] != device or (reconnect and reconnect != config[1]):
        return None
    _, profile, driver, unit = config
    if profile_matches_kind(profile, kind):
        return profile, driver, unit
    return None


def reconnect_profile(device, profile):
    return run('nmcli', '-w', '25', 'connection', 'up', 'uuid', profile, 'ifname', device,
               timeout=28)


def active_profile(device):
    code, output = run('nmcli', '-t', '-e', 'no', '-f', 'GENERAL.STATE,GENERAL.CON-UUID',
                       'device', 'show', device)
    data = dict(line.split(':', 1) for line in output.splitlines() if ':' in line)
    if code or 'GENERAL.STATE' not in data or 'GENERAL.CON-UUID' not in data:
        return None, ''
    state = data['GENERAL.STATE'].partition(' ')[0]
    return state, data['GENERAL.CON-UUID']


def usb_wake_available(device):
    return run(USB_WAKE_HELPER, '--check', device)[0] == 0


def repair_usb_ethernet(device, attempt):
    code, output = attempt('Wake USB Ethernet. Approve authentication if prompted.',
                           lambda: run('/usr/bin/pkexec', '--disable-internal-agent',
                                       USB_WAKE_HELPER, device, timeout=None))
    if code in (126, 127):
        return code, 'Authentication was cancelled or unavailable.'
    if code:
        return code, output

    def wait_for_networkmanager():
        deadline = time.monotonic() + 25
        while time.monotonic() < deadline:
            state, _ = active_profile(device)
            if state == '100':
                return 0, 'NetworkManager activated the wired connection.'
            if state is None:
                return 1, 'The Ethernet adapter became unavailable.'
            time.sleep(0.5)
        return 1, 'The USB adapter reported a link, but NetworkManager did not finish connecting.'

    return attempt('Wait for NetworkManager to connect Ethernet', wait_for_networkmanager)


def repair_connection(device, kind, profile, recovery, attempt, *, wake_usb=False):
    locks = STATE_DIR / 'locks'
    locks.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (locks / f'{quote(device, safe="")}.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 1, 'Another repair is already running for this adapter.'
        if wake_usb:
            return repair_usb_ethernet(device, attempt)
        return repair_locked(device, kind, profile, recovery, attempt)


def repair_locked(device, kind, profile, recovery, attempt):
    initial_state, current = active_profile(device)
    if initial_state is None or current not in ('', '--', profile):
        return 1, 'The adapter or its active profile changed. Check it again before repairing.'

    code, output = attempt('Reconnect saved profile', lambda: reconnect_profile(device, profile))
    if code == 0:
        return code, output

    state, current = active_profile(device)
    if initial_state != '100' and state == '100' and current == profile:
        return 0, 'The saved profile finished connecting.'
    if state is None or current not in ('', '--', profile):
        return code, output

    if recovery and state != '100':
        _, driver, unit = recovery
        blocker = driver_recovery_blocker(device, kind, driver)
        if not blocker and not recovery_unit_loaded(unit):
            blocker = f'{unit} is not loaded.'
        if blocker:
            return code, f'{output}\n\nDriver recovery skipped. {blocker}'
        code, output = attempt('Restart adapter via recovery service. Approve authentication if prompted.',
                               lambda: run('/usr/bin/pkexec', '/usr/bin/systemctl', '--wait', 'start',
                                           unit, timeout=150))
        if code in (126, 127):
            return code, 'Authentication was cancelled or unavailable.'
        if code == 124:
            return code, 'The driver recovery service did not finish in time.'
        if code:
            return code, output or f'{unit} failed. See the recovery service log in the report.'
        state, current = active_profile(device)
        if state == '100' and current == profile:
            return 0, 'The saved profile reconnected after driver recovery.'
        if (state is None or current not in ('', '--', profile)
                or driver_recovery_blocker(device, kind, driver)):
            return 1, 'The saved profile is still down and the adapter state prevents another retry.'
        return attempt('Reconnect after driver recovery',
                       lambda: reconnect_profile(device, profile))

    if current == profile:
        code, output = attempt('Disconnect selected adapter',
                               lambda: run('nmcli', '-w', '8', 'device', 'disconnect', device, timeout=10))
        if code:
            return code, output
    return attempt('Retry saved profile', lambda: reconnect_profile(device, profile))


def report_text(device, kind, result, details, recovery):
    headline, rows, _, _ = result
    timestamp = datetime.now().astimezone().isoformat(timespec='seconds')
    checks = '\n'.join(f'{step} — {status}. {note}' for step, (status, note) in rows.items())
    _, logs = run('journalctl', '-b', '--since=-15min', '-n', '35', '--no-pager',
                  '-u', 'NetworkManager', '-u', 'wpa_supplicant', '-u', 'iwd',
                  '--grep', rf'\b{re.escape(device)}\b')
    sections = [f'{TITLE}\n{timestamp}\n{kind} · {device}\n{headline}', checks, *details,
                f'Recent adapter logs (last 15 minutes):\n{logs}']
    if recovery:
        _, logs = run('journalctl', '-b', '--since=-15min', '-n', '20', '--no-pager',
                      '-u', recovery[-1])
        sections.append(f'Recent driver recovery logs (last 15 minutes):\n{logs}')
    return '\n\n'.join(sections)


def redacted_report(kind, result, steps, before=None):
    # Build from statuses instead of trying to redact arbitrary journal output.
    def checks(snapshot):
        return '\n'.join(f'{step} — {status}' for step, (status, _) in snapshot[1].items())

    text = f'{TITLE} — redacted report\nAdapter type: {kind}\n\n'
    if before:
        text += f'Before repair\n{checks(before)}\n\n'
    if steps:
        text += '\n'.join(f'{label} — exit {code}' for label, code, _ in steps) + '\n\n'
    return text + ('After repair\n' if before else '') + checks(result)


def view_report(path, redacted):
    action = desktop('--text-info', '--no-markup', '--wrap', '--width=760', '--height=490',
                     f'--text=Private report saved to {path}', f'--filename={path}',
                     '--button=Back:0', '--button=Copy redacted:17')
    if action.returncode == 17:
        try:
            subprocess.run(['wl-copy'], input=redacted, text=True, check=True, timeout=5)
        except (OSError, subprocess.SubprocessError) as error:
            desktop('--image=dialog-error', '--no-markup',
                    f'--text=Could not copy report: {error}', '--button=Close:0')


def show(device, kind, result, repair_notice=''):
    headline, rows, _, portal = result
    buttons = ['--button=Close:0', '--button=Choose adapter:10', '--button=View report:16',
               '--button=Ping target:14', '--button=DNS target:18',
               '--button=Check again:11', '--button=Repair connection:12']
    if portal:
        label = 'Open sign-in' if rows['Sign-in'][0] == 'Required' else 'Try sign-in'
        buttons += [f'--button={label}:13']
    cells = [escape(cell) for step, (state, detail) in rows.items() for cell in (step, state, detail)]
    notice = f'\n{escape(repair_notice)}' if repair_notice else ''
    return desktop('--list', '--width=760', '--height=370', '--text-width=75',
                   f'--text=<b>{escape(headline)}</b>\n{escape(kind)} · {escape(device)}{notice}',
                   '--text-align=left', '--response=0', '--no-selection', '--grid-lines=horizontal',
                   '--column=Check', '--column=Result', '--column=Details',
                   '--expand-column=3', '--wrap-cols=3', '--wrap-width=395',
                   *buttons, '--', *cells).returncode


def working(message, operation):
    with subprocess.Popen(['yad', '--progress', '--continuous', '--hide-text', '--no-buttons',
                           '--fixed', '--center', '--width=420', f'--title={TITLE}',
                           f'--text={message}'], stdin=subprocess.PIPE) as progress:
        try:
            return operation()
        finally:
            progress.terminate()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--gui', action='store_true', help='open the desktop interface')
    mode.add_argument('--list-adapters', action='store_true', help='list managed Wi-Fi and Ethernet adapters')
    mode.add_argument('--repair', action='store_true', help='repair the selected adapter after confirmation')
    mode.add_argument('--sign-in', action='store_true', help='open sign-in if needed on the selected adapter')
    mode.add_argument('--configure-recovery', metavar='UNIT', help='save an installed driver recovery service')
    parser.add_argument('--yes', action='store_true', help='confirm --repair without prompting')
    parser.add_argument('--device', help='adapter to check')
    parser.add_argument('--profile', metavar='UUID', help='saved NetworkManager profile for --configure-recovery')
    parser.add_argument('--ping-target', type=parse_ping_target, help='override the public ping targets')
    parser.add_argument('--dns-target', type=parse_dns_target, metavar='HOSTNAME',
                        help='compare DNS resolution for a hostname on the selected adapter and system resolver')
    report_mode = parser.add_mutually_exclusive_group()
    report_mode.add_argument('--report', action='store_true', help='print the private report')
    report_mode.add_argument('--redacted-report', action='store_true', help='print a shareable report')
    args = parser.parse_args()
    if args.yes and not args.repair:
        parser.error('--yes requires --repair')
    if args.configure_recovery is not None:
        if not args.device or not args.profile:
            parser.error('--configure-recovery requires --device and --profile')
        if args.ping_target or args.dns_target or args.report or args.redacted_report:
            parser.error('--configure-recovery does not run diagnostics or generate a report')
        try:
            path = configure_recovery(args.device, args.profile, args.configure_recovery)
        except (ValueError, OSError) as error:
            parser.exit(1, f'{error}\n')
        print(f'Saved driver recovery settings to {path}.')
        return 0
    if args.profile is not None:
        parser.error('--profile requires --configure-recovery')
    ping_target, dns_target = args.ping_target, args.dns_target

    def activity(message, operation):
        if args.gui:
            return working(message, operation)
        if args.repair:
            print(message, file=sys.stderr)
        return operation()

    device = args.device
    config = recovery_settings()
    path = before = snapshot = None
    history = repair_notice = ''
    steps = []
    ethernet_history = {}

    def scan():
        details = []
        hint = config[1] if config and config[0] == device else None
        result = activity('Checking this adapter…',
                          lambda: diagnose(device, kind, ping_target, details, hint,
                                           dns_target=dns_target, ethernet_history=ethernet_history))
        recovery = configured_recovery(device, kind, config, result[2])
        return result, recovery, report_text(device, kind, result, details, config if hint else None)

    while True:
        devices, error = adapters()
        if not devices or (device and device not in {row[0] for row in devices}):
            message = error or (f'Adapter {device} is unavailable.' if device else
                                'No NetworkManager-managed Wi-Fi or Ethernet adapter was found.')
            if args.gui:
                action = desktop('--image=dialog-information', '--no-markup', f'--text={message}', '--button=Close:0',
                                 '--button=Choose adapter:10', '--button=Check again:11').returncode
                if action == 10:
                    device = path = before = snapshot = None
                    history = repair_notice = ''
                    steps = []
                if action in (10, 11):
                    continue
            else:
                print(message, file=sys.stderr)
            return 1
        if args.list_adapters or not device and not args.gui and len(devices) > 1:
            for row in devices:
                print(*row, sep='\t')
            if not args.list_adapters:
                print('Run again with --device ADAPTER.', file=sys.stderr)
            return int(not args.list_adapters and (
                args.repair or args.sign_in or args.report or args.redacted_report or bool(args.dns_target)))
        if not device:
            device = choose(devices) if args.gui else devices[0][0]
            if not device:
                return 0
        kind = next(row[1] for row in devices if row[0] == device)

        if path is None:
            STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
            with tempfile.NamedTemporaryFile(prefix='network-', suffix='.txt', dir=STATE_DIR,
                                             delete=False) as report:
                path = Path(report.name)
        result, recovery, private = snapshot if snapshot is not None else scan()
        snapshot = None
        path.write_text(('After repair\n' if before else '') + private + history + '\n',
                        encoding='utf-8')
        redacted = redacted_report(kind, result, steps, before)
        action = show(device, kind, result, repair_notice) if args.gui else 12 if args.repair else 13 if args.sign_in else 0
        while action == 16:
            view_report(path, redacted)
            action = show(device, kind, result, repair_notice)
        code = 0

        if action == 10:
            device = path = before = None
            history = repair_notice = ''
            steps = []
            continue
        if action == 14:
            ping_target = edit_target(
                ping_target, 'IP address', 'Enter an IPv4 or IPv6 address to ping through the selected adapter.',
                parse_ping_target, 'Enter an IP address such as 192.168.1.1 or fe80::1.')
            continue
        if action == 18:
            dns_target = edit_target(
                dns_target, 'Hostname', 'Enter the hostname that fails to resolve.',
                parse_dns_target, 'Enter a hostname such as example.org.')
            continue
        if action == 11:
            repair_notice = ''
            continue
        if action == 12:
            profile = recovery[0] if recovery else result[2]
            link_status, link_detail = result[1]['Link']
            wake_usb = kind == 'Ethernet' and link_status == 'No cable link' and usb_wake_available(device)
            blocked = link_status in ('Off', 'No cable link', 'Unavailable') and not wake_usb
            message = (f'Retry the saved profile on {device}? If it fails, the app will retry after '
                       'disconnecting that connection if it is active.')
            if recovery:
                message = (f'Retry the saved profile on {device}? If it fails, the app can restart '
                           'the adapter using the configured recovery service and may ask for authentication.')
            if wake_usb:
                message = ('Wake the USB Ethernet adapter and check the connection? '
                           'You may be asked to authenticate.')
            if blocked:
                code, output = 1, f'{result[0]}. {link_detail}'
            elif not profile and not wake_usb:
                code, output = 1, ('No single saved profile could be selected. Choose the network '
                                   'from your network menu and check this adapter again.')
            elif args.gui:
                confirmed = desktop('--image=dialog-question', '--no-markup',
                                    f'--text={message}', '--button=Cancel:1',
                                    '--button=Repair connection:0').returncode == 0
            elif args.yes:
                confirmed = True
            elif sys.stdin.isatty():
                print(f'{message} [y/N] ', end='', file=sys.stderr, flush=True)
                confirmed = sys.stdin.readline().strip().lower() in ('y', 'yes')
            else:
                parser.error('--repair requires --yes when stdin is not a terminal')

            if code == 0 and confirmed:
                before = result
                before_report = private
                previous_history = history
                steps = []

                def save_attempts(pending=''):
                    attempts = [f'{label} (exit {status})\n{detail}' for label, status, detail in steps]
                    if pending:
                        attempts.append(f'{pending}\nIn progress')
                    return ('\n\nRepair attempts\n' + '\n\n'.join(attempts)
                            + f'\n\nBefore repair\n{before_report}{previous_history}')

                def attempt(label, operation):
                    path.write_text(save_attempts(label).lstrip() + '\n', encoding='utf-8')
                    outcome = activity(label, operation)
                    steps.append((label, *outcome))
                    path.write_text(save_attempts().lstrip() + '\n', encoding='utf-8')
                    return outcome

                code, output = repair_connection(device, kind, profile, recovery, attempt, wake_usb=wake_usb)
                history = save_attempts('Checking this adapter again')
                path.write_text(history.lstrip() + '\n', encoding='utf-8')
                result, recovery, private = scan()
                if code:
                    repair_notice = 'Repair stopped. View the report for the steps and error.'
                elif result[1]['Sign-in'][0] == 'Required':
                    code, output = 1, 'The connection is up. Open sign-in to get internet access.'
                    repair_notice = output
                elif result[1]['Internet'][0] != 'Reached':
                    code, output = 1, 'The reconnect command finished, but this adapter did not pass the internet check.'
                    repair_notice = output
                else:
                    repair_notice = 'Repair complete. Internet access verified.'
                steps.append(('Repair result', code, output))
                history = save_attempts()
                path.write_text(f'After repair\n{private}{history}\n', encoding='utf-8')
                redacted = redacted_report(kind, result, steps, before)
                snapshot = result, recovery, private
            elif code == 0:
                if args.gui:
                    snapshot = result, recovery, private
                    continue
                code, output = 1, 'Repair cancelled.'
        elif action == 13:
            if result[3]:
                code, output = launch_portal(device, kind, result[3])
                steps.append(('Open sign-in', code, output))
                history = f'\n\nSign-in handoff (exit {code}):\n{output}{history}'
                path.write_text(private + history + '\n', encoding='utf-8')
                redacted = redacted_report(kind, result, steps, before)
            else:
                code, output = 1, 'This check did not find a sign-in page to open.'

        if code:
            if args.gui:
                desktop('--image=dialog-error', '--no-markup', f'--text={output}', '--button=Close:0')
            else:
                print(output, file=sys.stderr)
        if args.gui:
            if action == 12 or code:
                continue
            return 0
        if args.report:
            print(path.read_text(encoding='utf-8').rstrip())
        elif args.redacted_report:
            print(redacted)
        else:
            headline, rows, _, _ = result
            print(f'{kind} · {device}\n{headline}')
            for step, (status, detail) in rows.items():
                print(f'{step} — {status}. {detail}')
        print(f'Private report saved to {path}', file=sys.stderr)
        return int(bool(code))


if __name__ == '__main__':
    raise SystemExit(main())
