#!/usr/bin/python3 -I
"""Temporarily resume the Surface Thunderbolt 4 Dock's USB Ethernet device."""
import argparse
import os
from pathlib import Path
import time

NET = Path('/sys/class/net')


def wake(interface, check):
    if not interface or Path(interface).name != interface or interface in ('.', '..'):
        raise ValueError('Enter a network interface name.')
    net = (NET / interface).resolve(strict=True)
    usb_interface = (net / 'device').resolve(strict=True)
    if (usb_interface / 'driver').resolve(strict=True).name != 'cdc_ncm':
        raise ValueError('This Ethernet adapter does not support the dock USB wake step.')

    # Keep the USB directory open so a dock unplug cannot redirect a write to
    # a different device that later appears at the same USB address.
    usb = os.open(usb_interface.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        def open_usb(path, mode='r'):
            return open(path, mode, encoding='ascii',
                        opener=lambda name, flags: os.open(name, flags, dir_fd=usb))

        with open_usb('idVendor') as vendor, open_usb('idProduct') as product:
            if (vendor.read().strip(), product.read().strip()) != ('045e', '085c'):
                raise ValueError('This Ethernet adapter does not support the dock USB wake step.')
        if check:
            return 'USB wake is available for this dock Ethernet adapter.'
        if os.geteuid() != 0:
            raise ValueError('USB wake requires administrator authentication.')

        with (net / 'carrier').open(encoding='ascii') as carrier, open_usb('power/control', 'r+') as control:
            if carrier.read().strip() == '1':
                return 'Ethernet already has a link.'
            previous = control.read().strip()

            def set_power(value):
                control.seek(0)
                control.write(value + '\n')
                control.flush()

            try:
                if previous == 'auto':
                    set_power('on')
                deadline = time.monotonic() + 12
                while time.monotonic() < deadline:
                    carrier.seek(0)
                    if carrier.read().strip() == '1':
                        return 'Ethernet link detected after waking the USB adapter.'
                    time.sleep(0.25)
                raise ValueError('Still no Ethernet link after waking the USB adapter. Check the cable or switch port.')
            finally:
                if previous == 'auto':
                    set_power(previous)
    finally:
        os.close(usb)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('interface')
    parser.add_argument('--check', action='store_true', help='check hardware support without waking the adapter')
    args = parser.parse_args()
    try:
        print(wake(args.interface, args.check))
    except (OSError, ValueError) as error:
        parser.exit(1, f'{error}\n')


if __name__ == '__main__':
    main()
